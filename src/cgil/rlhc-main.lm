#
# The program each translator runs. The rlhc-<lang>.lm that includes this
# defines trans() and sets Translator, the translator's name.
#

#
# Arguments
#
if ( argv->length != 2 ) {
	send stderr "usage: [Translator] INPUT OUTPUT
	exit(1)
}

InputFile: str = argv->pop()
OutputFile: str = argv->pop()

#
# Open input and parse
#
Input: stream = open( InputFile, "r" )
if ( !Input ) {
	send stderr "could not open [InputFile] for reading
	exit(1)
}

parse Start: start[ Input ]
if ( !Start ) {
	send stderr "[error]
	exit(1)
}

#
# Translate
#
Output: stream = open( OutputFile, "w" )
if ( !Output ) {
	send stderr "could not open [OutputFile] for writing
	exit(1)
}

trans( Output, Start )
