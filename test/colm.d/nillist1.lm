# Using a nil list stops the program, with exit status 1: pushing a value or an
# element at either end, its length, and the element at either end. So does
# pushing a nil element onto a list. The output before the stop is kept. In a
# reduction action, a push is the form that records reverse code. The run "new"
# gives the list a value first, and nothing stops.

lex
	token id /[a-z]+/
	ignore /[ \n]+/
end

struct holder
	L: list<int>
end

global N: list<int>
global L: list<int> = new list<int>()
global A: str = argv->pop()

def start
	[id]
	{
		if ( A == "new" ) {
			N->push_head( 1 )
			N->push_tail( 2 )
			new E: list_el<int>()
			E->value = 3
			N->push_head_el( E )
			new F: list_el<int>()
			F->value = 4
			N->push_tail_el( F )
		}
		elsif ( A == "action_push_head" )
			N->push_head( 1 )
		elsif ( A == "action_push_tail" )
			N->push_tail( 1 )
		elsif ( A == "action_push_head_el" ) {
			new E: list_el<int>()
			N->push_head_el( E )
		}
		elsif ( A == "action_push_tail_el" ) {
			new E: list_el<int>()
			N->push_tail_el( E )
		}
		elsif ( A == "action_nil_el_push_head_el" ) {
			E: list_el<int>
			L->push_head_el( E )
		}
		elsif ( A == "action_nil_el_push_tail_el" ) {
			E: list_el<int>
			L->push_tail_el( E )
		}
	}

print( "before\n" )

if ( A == "push" )
	N->push( 1 )
elsif ( A == "push_head" )
	N->push_head( 1 )
elsif ( A == "push_tail" )
	N->push_tail( 1 )
elsif ( A == "push_el" ) {
	new E: list_el<int>()
	N->push_el( E )
}
elsif ( A == "push_head_el" ) {
	new E: list_el<int>()
	N->push_head_el( E )
}
elsif ( A == "push_tail_el" ) {
	new E: list_el<int>()
	N->push_tail_el( E )
}
elsif ( A == "length" )
	print( "length [N->length]\n" )
elsif ( A == "head_el" ) {
	E: list_el<int> = N->head_el
}
elsif ( A == "tail_el" ) {
	E: list_el<int> = N->tail_el
}
elsif ( A == "top_el" ) {
	E: list_el<int> = N->top_el
}
elsif ( A == "nil_el_push_el" ) {
	E: list_el<int>
	L->push_el( E )
}
elsif ( A == "nil_el_push_head_el" ) {
	E: list_el<int>
	L->push_head_el( E )
}
elsif ( A == "nil_el_push_tail_el" ) {
	E: list_el<int>
	L->push_tail_el( E )
}
elsif ( A == "field" ) {
	new H: holder()
	H->L->push( 1 )
}
elsif ( A == "new" ) {
	N = new list<int>()
	N->push( 5 )
	N->push_head( 6 )
	N->push_tail( 7 )
	new E: list_el<int>()
	E->value = 8
	N->push_el( E )
	new F: list_el<int>()
	F->value = 9
	N->push_head_el( F )
	new G: list_el<int>()
	G->value = 10
	N->push_tail_el( G )
	print( "length [N->length], head_el [N->head_el->value], " )
	print( "tail_el [N->tail_el->value], top_el [N->top_el->value]\n" )
}

S: start = parse start[ "x" ]
print( "length [N->length], head [N->head], tail [N->tail]\n" )
print( "after\n" )
