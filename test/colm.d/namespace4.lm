# root:: at the front of a qualified call or global starts at the top level,
# even inside a namespace with names of its own.
int t() { return 1 }
global T: int = 5

namespace a
	int t() { return 2 }
	global T: int = 6

	namespace b
		int f() { return 3 }
	end

	int g() { return root::t() + root::T }
end

print( root::a::b::f(), " ", root::t(), " ", root::T, " ", a::g(), "\n" )
##### EXP #####
3 1 5 6
