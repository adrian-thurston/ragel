# -e naming the program colm compiles is an error, and colm stops before it
# compiles the program or writes anything, so the program is left as it was.
export str f( S: str )
{
	return "r" + S
}
##### COMP #####
-c -o working/outfile1.c -e working/outfile1.lm -x working/outfile1.cc
##### COMP_ERR #####
error: colm: output file "working/outfile1.lm" is the same as the input file
