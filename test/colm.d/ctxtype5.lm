# In a token action, this is an object of the token's context. A parse the
# action starts, of a type in another context, can't be given it.
context d
	K: str
	lex
		token rword /[a-z]+/
		ignore /space+/
	end
	def rest
		[rword]
		{
			K = K + $r1
		}
end
context c
	N: int
	lex
		token word /[a-z]+/
		{
			W: str = input->pull( match_length )
			parse_stop R: d::rest( this input )[]
			input->push( make_token( typeid<word>, W ) )
		}
		ignore /space+/
	end
	def start [word*]
end
C: c = new c()
parse S: c::start( C )[ "a x b" ]
print( S, "\n" )
##### COMP_ERR #####
21:27: the context of d::rest must be of type d, not c
