# A parse or a new parser given a context variable that holds nil stops the
# program with exit status 1. The host sends standard error to standard
# output, so the message is in the output, after what the program printed
# before it. The stop ends the host too: it never gets back from
# colm_run_program.

context c
	I: int
	lex
		token id /[a-z]+/
		ignore /space+/
	end
	def item
		[id]
		{
			I = I + 1
		}
	def start [item*]
end

C: c

A: str = argv->pop()
print( "before\n" )

if ( A == "parse" ) {
	parse S: c::start( C )[ "a b" ]
}
elsif ( A == "new" ) {
	P: parser<c::start> = new parser<c::start>( C )
	send P "a b" eos
}

print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
parse
##### EXP #####
before
fatal: giving a parser a nil context
##### EXIT #####
1
##### ARGS #####
new
##### EXP #####
before
fatal: giving a parser a nil context
##### EXIT #####
1
