# A parser made with new, of a type in a context, given more than its context.

context c
	I: int
	lex
		token id /[a-z]+/
		ignore /space+/
	end
	def start [id*]
end
C: c = new c()
P: parser<c::start> = new parser<c::start>( C C )
##### COMP_ERR #####
12:23: new parser<c::start> takes one argument, its context
