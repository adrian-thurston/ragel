# The message each use of a nil map stops the program with. The host sends
# standard error to standard output, so the message is in the output, after
# what the program printed before it. The stop ends the host too: it never
# gets back from colm_run_program.

M: map<str, int>
I: int

A: str = argv->pop()
print( "before\n" )

if ( A == "insert" )
	M->insert( "a", 1 )
elsif ( A == "insert_el" ) {
	new E: map_el<str, int>()
	E->key = "a"
	M->insert_el( E )
}
elsif ( A == "find" )
	I = M->find( "a" )
elsif ( A == "find_el" ) {
	E: map_el<str, int> = M->find_el( "a" )
}
elsif ( A == "remove" )
	M->remove( "a" )
elsif ( A == "detach_el" ) {
	new E: map_el<str, int>()
	M->detach_el( E )
}
elsif ( A == "length" )
	I = M->length
elsif ( A == "head_el" ) {
	E: map_el<str, int> = M->head_el
}
elsif ( A == "tail_el" ) {
	E: map_el<str, int> = M->tail_el
}

print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
insert
##### EXP #####
before
fatal: insert into a nil map
##### EXIT #####
1
##### ARGS #####
insert_el
##### EXP #####
before
fatal: insert into a nil map
##### EXIT #####
1
##### ARGS #####
find
##### EXP #####
before
fatal: find in a nil map
##### EXIT #####
1
##### ARGS #####
find_el
##### EXP #####
before
fatal: find in a nil map
##### EXIT #####
1
##### ARGS #####
remove
##### EXP #####
before
fatal: remove from a nil map
##### EXIT #####
1
##### ARGS #####
detach_el
##### EXP #####
before
fatal: detach from a nil map
##### EXIT #####
1
##### ARGS #####
length
##### EXP #####
before
fatal: length of a nil map
##### EXIT #####
1
##### ARGS #####
head_el
##### EXP #####
before
fatal: reading the head of a nil map
##### EXIT #####
1
##### ARGS #####
tail_el
##### EXP #####
before
fatal: reading the tail of a nil map
##### EXIT #####
1
