#
# An exit that can unwind the stack returns to the host, which goes on and
# gets the exit status from colm_delete_program. That holds for a call that
# is the whole expression of an expression statement, an assignment, a
# return, or an if or while test. An exit that can't unwind, reached through
# a call inside a larger expression, ends the host's process too.
#

int f2()
{
	print( 'f2\n' )
	exit( 3 )
	return 1
}

int f1()
{
	I: int = 1 + f2()
	return 0
}

int f3( A: str )
{
	if ( A == "assign" ) {
		I: int = f2()
	}
	elsif ( A == "return" ) {
		return f2()
	}
	elsif ( A == "if" ) {
		if ( f2() )
			print( 'yes\n' )
	}
	elsif ( A == "while" ) {
		while ( f2() )
			print( 'yes\n' )
	}
	return 0
}

A: str = argv->pop()
if ( A == "stmt" )
	f2()
elsif ( A == "nested" )
	f1()
else
	f3( A )
print( 'after\n' )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
stmt
##### EXP #####
f2
host: exit status 3
##### EXIT #####
3
##### ARGS #####
nested
##### EXP #####
f2
##### EXIT #####
3
##### ARGS #####
assign
##### EXP #####
f2
host: exit status 3
##### EXIT #####
3
##### ARGS #####
return
##### EXP #####
f2
host: exit status 3
##### EXIT #####
3
##### ARGS #####
if
##### EXP #####
f2
host: exit status 3
##### EXIT #####
3
##### ARGS #####
while
##### EXP #####
f2
host: exit status 3
##### EXIT #####
3
