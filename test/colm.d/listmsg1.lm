# The message each error with a list stops the program with. The host sends
# standard error to standard output, so the message is in the output, after
# what the program printed before it. The stop ends the host too: it never
# gets back from colm_run_program.

L: list<int> = new list<int>()
N: list<int>
I: int

A: str = argv->pop()
print( "before\n" )

if ( A == "pop" )
	I = L->pop()
elsif ( A == "pop_nil" )
	I = N->pop()
elsif ( A == "head" )
	I = L->head
elsif ( A == "tail" )
	I = L->tail
elsif ( A == "top_nil" )
	I = N->top
elsif ( A == "for_nil" ) {
	for V: int in N
		print( "[V]\n" )
}
elsif ( A == "push_nil" )
	N->push( 1 )
elsif ( A == "push_tail_el_nil" ) {
	new E: list_el<int>()
	N->push_tail_el( E )
}
elsif ( A == "length_nil" )
	I = N->length
elsif ( A == "head_el_nil" ) {
	E: list_el<int> = N->head_el
}
elsif ( A == "tail_el_nil" ) {
	E: list_el<int> = N->tail_el
}
elsif ( A == "nil_element" ) {
	E: list_el<int>
	L->push_el( E )
}

print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
pop
##### EXP #####
before
fatal: pop from an empty list
##### EXIT #####
1
##### ARGS #####
pop_nil
##### EXP #####
before
fatal: pop from a nil list
##### EXIT #####
1
##### ARGS #####
head
##### EXP #####
before
fatal: reading the head of an empty list
##### EXIT #####
1
##### ARGS #####
tail
##### EXP #####
before
fatal: reading the tail of an empty list
##### EXIT #####
1
##### ARGS #####
top_nil
##### EXP #####
before
fatal: reading the head of a nil list
##### EXIT #####
1
##### ARGS #####
for_nil
##### EXP #####
before
fatal: for loop over a nil list
##### EXIT #####
1
##### ARGS #####
push_nil
##### EXP #####
before
fatal: push to a nil list
##### EXIT #####
1
##### ARGS #####
push_tail_el_nil
##### EXP #####
before
fatal: push to a nil list
##### EXIT #####
1
##### ARGS #####
length_nil
##### EXP #####
before
fatal: length of a nil list
##### EXIT #####
1
##### ARGS #####
head_el_nil
##### EXP #####
before
fatal: reading the head of a nil list
##### EXIT #####
1
##### ARGS #####
tail_el_nil
##### EXP #####
before
fatal: reading the tail of a nil list
##### EXIT #####
1
##### ARGS #####
nil_element
##### EXP #####
before
fatal: pushing a nil element
##### EXIT #####
1
