# The input of a token action has no close either.
lex
	ignore /[ \n]+/
	token id /[a-z]+/
	{
		input->close()
		input->push( make_token( typeid<id>, input->pull( match_length ) ) )
	}
end

def start
	[id*]

parse S: start [ 'a b' ]
print( S, '\n' )
