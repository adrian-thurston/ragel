# A token action outside a context has no this: there is no context for it
# to be an object of.
context c
	N: int
	lex
		token rword /[a-z]+/
		ignore /space+/
	end
	def rw
		[rword]
		{
			N = N + 1
		}
	def rest [rw]
end
lex
	token word /[a-z]+/
	{
		W: str = input->pull( match_length )
		parse_stop R: c::rest( this input )[]
		input->push( make_token( typeid<word>, W ) )
	}
	ignore /space+/
end
def start [word*]
parse S: start[ "a x b" ]
print( S, "\n" )
