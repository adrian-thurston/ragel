# The message reading a parser's tree before its input has ended stops the
# program with. The host sends standard error to standard output, so the
# message is in the output, after what the program printed before it. The stop
# ends the host too: it never gets back from colm_run_program.

lex
	token id /[a-z]+/
	token num /[0-9]+/
	literal `;
	ignore /space+/
end

def stmt
	[id num `;]

def start
	[Stmts: stmt*]

P: parser<start> = new parser<start>()
send P "a 1; b 2;\n"
print( "before\n" )
T: start = P->tree
print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### EXP #####
before
fatal: reading the tree of a parser before its input has ended
##### EXIT #####
1
