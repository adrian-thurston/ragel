# The message each use of a nil tree stops the program with. The host sends
# standard error to standard output, so the message is in the output, after
# what the program printed before it. The stop ends the host too: it never
# gets back from colm_run_program.

lex
	token id /[a-z]+/
	token num /[0-9]+/
	ignore /[ \n]+/
end

def pair
	T: id
	[L: id R: num]

S: pair
parse P: pair[ "x 1" ]
I: id = P.L

A: str = argv->pop()
print( "before\n" )

if ( A == "child" )
	I = S.L
elsif ( A == "set_child" )
	S.L = I
elsif ( A == "attr" )
	I = S.T
elsif ( A == "set_attr" )
	S.T = I

print( "after\n" )
##### HOST #####

#include <colm/colm.h>
#include <stdio.h>
#include <unistd.h>

extern colm_sections colm_object;

int main( int argc, const char **argv )
{
	dup2( 1, 2 );

	colm_program *program = colm_new_program( &colm_object );
	colm_run_program( program, argc, argv );
	int status = colm_delete_program( program );

	printf( "host: exit status %d\n", status );
	return status;
}
##### ARGS #####
child
##### EXP #####
before
fatal: reading a child of a nil tree
##### EXIT #####
1
##### ARGS #####
set_child
##### EXP #####
before
fatal: setting a child of a nil tree
##### EXIT #####
1
##### ARGS #####
attr
##### EXP #####
before
fatal: reading an attribute of a nil tree
##### EXIT #####
1
##### ARGS #####
set_attr
##### EXP #####
before
fatal: setting an attribute of a nil tree
##### EXIT #####
1
