lex
	token comment /'/*' any* :>> '*/'/
	token string /'"""' ( any* -- '"""' ) '"""'/
	token word /[a-z]+/
	ignore /space+/
end

def item
	[comment]
|	[string]
|	[word]

def items
	[item*]

parse Items: items[ stdin ]

if ( ! Items ) {
	print( error, "\n" )
	exit( 1 )
}

for I: item in Items {
	if match I [comment]
		print( "comment: ", $I, "\n" )
	elsif match I [string]
		print( "string: ", $I, "\n" )
	else
		print( "word: ", $I, "\n" )
}
