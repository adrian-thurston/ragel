lex
	token name /[a-z]+/
	token number /[0-9]+/
	literal `= `;
	ignore /[ \t\n]+/
end

def setting
	[name `= number `;]

def settings
	[setting*]

parse Settings: settings[ stdin ]

if ( ! Settings ) {
	print( error, "\n" )
	exit( 1 )
}

# Reports a name set a second time, at the place it is set again, and stops.
void twice( Again: name, First: name )
{
	print( Again.file, ":", Again.line, ":", Again.col, ": ", $Again,
			" is set again, first set on line ", First.line, "\n" )
	exit( 1 )
}

Seen: map<str, name> = new map<str, name>()
for S: setting in Settings {
	First: name = Seen->find( $S.name )
	if ( First )
		twice( S.name, First )
	Seen->insert( $S.name, S.name )
}

print( Seen->length, " settings\n" )
