lex
	token name /[a-z]+/
	token number /[0-9]+/
	literal `= `;
	ignore /[ \t\n]+/
end

def setting
	[name `= number `;]

def settings
	[setting*]

parse Settings: settings[ stdin ]

if ( ! Settings ) {
	print( "line ", error.line, ", column ", error.col, ": parse error\n" )
	exit( 1 )
}

for S: setting in Settings
	print( $S.name, " is ", $S.number, "\n" )
