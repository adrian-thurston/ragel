lex
	literal `.
	token number /[0-9]+/
	ignore /space+/
end

def octet
	[number]
	{
		if ( atoi( $r1 ) > 255 )
			reject
	}

def address
	[octet `. octet `. octet `. octet]

def version
	[number `. number `. number `. number]

def item
	[address]
|	[version]

def items
	[item*]

parse Items: items[ stdin ]

if ( ! Items ) {
	print( error, "\n" )
	exit( 1 )
}

for I: item in Items {
	if ( I.address )
		print( "address: ", $I, "\n" )
	else
		print( "version: ", $I, "\n" )
}
