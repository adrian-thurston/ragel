lex
	literal `* `+ `;
	token id /[a-z]+/
	ignore /space+/
end

def declaration
	[id id `;]
|	[id `* id `;]

def term
	[id `* term]
|	[id]

def expression
	[term `+ expression]
|	[term]

def statement
	[declaration] commit
	{
		print( "declaration: ", $lhs, "\n" )
	}
|	[expression `;] commit
	{
		print( "expression: ", $lhs, "\n" )
	}

def program
	[statement*]

parse Program: program[ stdin ]

if ( ! Program )
	print( error, "\n" )
